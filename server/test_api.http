### ===============================
### LAPTOP GALAXY STORE API TEST
### ===============================

@baseUrl = http://localhost:5000/api
@adminToken = your_admin_jwt_token_here
@userToken = your_user_jwt_token_here

### 1 Kiểm tra gốc
GET http://localhost:5000/

### 2 Đăng nhập
POST {{baseUrl}}/users/login
Content-Type: application/json

{
  "email": "user@example.com",
  "password": "password123"
}

### 3 Lấy thông tin user (Cần JWT)
GET {{baseUrl}}/users/profile
Authorization: Bearer {{userToken}}

### 4 Lấy tất cả sản phẩm
GET {{baseUrl}}/products

### 5 Thêm sản phẩm (Chỉ Admin)
POST {{baseUrl}}/products
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "name": "Asus ROG Zephyrus G14",
  "price": 35000000,
  "description": "Gaming laptop galaxy theme",
  "image": "/images/rog.jpg",
  "category": "category_id_here",
  "countInStock": 10,
  "specifications": {
    "cpu": "Ryzen 9",
    "ram": "32GB",
    "storage": "1TB SSD"
  }
}

### 6 Đặt hàng (Cần User Token)
POST {{baseUrl}}/orders
Content-Type: application/json
Authorization: Bearer {{userToken}}

{
  "orderItems": [
    {
      "name": "Asus ROG Zephyrus G14",
      "qty": 1,
      "image": "/images/rog.jpg",
      "price": 35000000,
      "product": "product_id_here"
    }
  ],
  "shippingAddress": {
    "address": "123 Galaxy St",
    "city": "Cyber City",
    "postalCode": "100000",
    "country": "VN"
  },
  "paymentMethod": "PayPal"
}
